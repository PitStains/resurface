{
  "name": "resurface-monorepo",
  "private": true,
  "version": "0.12.7",
  "description": "A local-first second brain for Snipd podcast notes: stats, hybrid search, Q&A with citations, topics and resurfacing.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PitStains/resurface.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/web/tsconfig.json",
    "import": "tsx packages/cli/src/cli.ts import",
    "doctor": "tsx packages/cli/src/cli.ts doctor",
    "build:web": "npm run build -w @resurface/web",
    "serve": "tsx packages/server/src/main.ts",
    "dev:web": "npm run dev -w @resurface/web"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1"
  }
}
